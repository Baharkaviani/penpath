# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1 backend

# Database
DB_NAME=penpath
DB_USER=penpath
DB_PASSWORD=penpath
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS (Vue dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF — include admin (port 8000) and frontend (5173)
CSRF_TRUSTED_ORIGINS=http://localhost:5173 http://localhost:8000 http://127.0.0.1:8000

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-vision.json
